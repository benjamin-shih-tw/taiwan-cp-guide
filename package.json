{
  "name": "taiwan-cp-guide-site",
  "private": true,
  "type": "module",
  "scripts": {
    "sync:notion": "node scripts/sync-notion-recordmaps.mjs",
    "build:notion": "esbuild v2/notion-renderer-entry.jsx --bundle --minify --format=iife --platform=browser --target=es2020 --outfile=v2/notion-renderer.js --loader:.js=jsx --loader:.woff=file --loader:.woff2=file --loader:.ttf=file --asset-names=notion-assets/[name]-[hash]",
    "build": "npm run sync:notion && npm run build:notion"
  },
  "dependencies": {
    "esbuild": "^0.25.0",
    "katex": "^0.16.11",
    "notion-client": "7.12.1",
    "notion-utils": "7.12.1",
    "prismjs": "^1.30.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-notion-x": "7.12.1"
  }
}
